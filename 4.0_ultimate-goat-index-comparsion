WITH v1_raw AS (
  SELECT 
    Player,
    Country,
    Runs,
    Average,
    Final_GOAT_Score AS score_v1
  FROM `mrdipeshashah.cricket_analysis.goat_index_v1`
),

v2_raw AS (
  SELECT 
    Player,
    Anchor_Era,
    Final_GOAT_Score_V2 AS score_v2
  FROM `mrdipeshashah.cricket_analysis.goat_index_v2`
  WHERE Anchor_Era != 'Pre-1970'  -- Excludes Pre-1970 cohort in SQL
),

-- Rank BOTH datasets ONLY across the matching modern players
filtered_joined AS (
  SELECT 
    v1.Player,
    v1.Country,
    v2.Anchor_Era,
    v1.Runs,
    v1.Average,
    v1.score_v1,
    v2.score_v2,
    ROW_NUMBER() OVER(ORDER BY v1.score_v1 DESC) AS rank_v1,
    ROW_NUMBER() OVER(ORDER BY v2.score_v2 DESC) AS rank_v2
  FROM v1_raw v1
  INNER JOIN v2_raw v2 ON v1.Player = v2.Player
)

SELECT 
  Player,
  Country,
  Anchor_Era,
  Runs,
  Average,
  
  -- Scores
  ROUND(score_v1, 2) AS score_v1,
  ROUND(score_v2, 2) AS score_v2,
  ROUND(score_v2 - score_v1, 2) AS score_delta,
  
  -- Ranks
  rank_v1,
  rank_v2,
  
  -- Rank Movement
  (rank_v1 - rank_v2) AS rank_positions_gained,
  
  -- Movement Label
  CASE 
    WHEN (rank_v1 - rank_v2) > 0 THEN 'Climber ⬆️'
    WHEN (rank_v1 - rank_v2) < 0 THEN 'Faller ⬇️'
    ELSE 'Unchanged ➖'
  END AS movement_category

FROM filtered_joined
ORDER BY rank_v2 ASC
